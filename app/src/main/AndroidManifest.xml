<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- HQ declares HQ Fit's permission too (same signing key), so it is granted whichever app is installed first. -->
    <permission android:name="uk.woozy.fit.permission.READ_SUMMARY" android:protectionLevel="signature" />
    <uses-permission android:name="uk.woozy.fit.permission.READ_SUMMARY" />
    <!-- HQ shares the profile picture (the Notion page icon) with HQ Fit. HQ Fit declares this permission too. -->
    <permission android:name="uk.woozy.hq.permission.READ_AVATAR" android:protectionLevel="signature" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="notion.id" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.instagram.android" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.sec.android.daemonapp" />
        <package android:name="com.cronometer.android" />
        <package android:name="uk.woozy.fit" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="HQ"
        android:theme="@style/Theme.HQ">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:resizeableActivity="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name=".AvatarProvider"
            android:authorities="uk.woozy.hq.avatar"
            android:exported="true"
            android:readPermission="uk.woozy.hq.permission.READ_AVATAR"
            android:writePermission="uk.woozy.hq.permission.READ_AVATAR" />

        <receiver
            android:name=".HqWidget"
            android:exported="true"
            android:label="HQ">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hq_widget_info" />
        </receiver>
    </application>
</manifest>
